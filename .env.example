OPENAI_API_KEY=<YOUR_API_KEY>

# General
# development disables the Secure cookie flag so sessions work over plain HTTP
# during local dev (uvicorn --reload on localhost). This file is the local-dev
# template (cp .env.example .env), so it defaults to development — override to
# production for any real deployment, since Secure is required there.
ENVIRONMENT=development

# Chat completion (docs/specifications/session_isolation.md, text_to_speech.md §4.5/§6)
CHAT_GPT_MODEL=gpt-4o
CHAT_GPT_TEMPERATURE=0.7
CHAT_GPT_MAX_TOKENS=1500
# max_tokens used instead of CHAT_GPT_MAX_TOKENS when audio_mode=true — a
# generous backstop, not a de facto length target (text_to_speech.md §4.5).
CHAT_GPT_MAX_TOKENS_AUDIO=800

# Retrieval pipeline — query expansion + rerank (docs/specifications/retrieval_pipeline.md)
QUERY_EXPANSION_MODEL=gpt-4o-mini
RERANK_MODEL=gpt-4o-mini
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_FINAL_K=5

# Session isolation (docs/specifications/session_isolation.md)
# SESSION_SECRET_KEY has no default — the app fails to start without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=<GENERATE_A_RANDOM_SECRET>
SESSION_COOKIE_NAME=gfrag_session
SESSION_TTL_DAYS=30
SESSION_MAX_MESSAGES=100
SESSION_STORE_MAX_SESSIONS=1000
CHAT_RATE_LIMIT=20/minute

# Read-aloud / text-to-speech (docs/specifications/text_to_speech.md)
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=cedar

# DigitalOcean Spaces — ChromaDB vector store (docs/specifications/digitalocean_deployment.md)
# Used by scripts/download_db.py at container startup to fetch app/db/ from Spaces.
# Not required for local development (ingestion writes directly to app/db/).
SPACES_KEY=<SPACES_ACCESS_KEY_ID>
SPACES_SECRET=<SPACES_SECRET_ACCESS_KEY>
SPACES_BUCKET=<YOUR_BUCKET_NAME>
SPACES_REGION=fra1
SPACES_DB_PREFIX=chroma-db/
TTS_SPEED=1.0
TTS_TIMEOUT_SECONDS=30
TTS_MAX_INPUT_CHARS=3800
TTS_AUDIO_CACHE_MAX_ENTRIES=200
TTS_AUDIO_CACHE_MAX_BYTES=104857600
TTS_MAX_CONCURRENT_REQUESTS=4
TTS_RATE_LIMIT=10/minute
